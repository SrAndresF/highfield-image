# ==============================================================================
# CONTROL DE ACCESO DEL EQUIPO (OPCIONAL)
# ==============================================================================
# Si defines APP_ACCESS_PASSWORD, la aplicación solicitará esta contraseña una
# única vez a cada miembro del equipo antes de mostrar la interfaz y antes de
# permitir llamadas a las rutas /api/*. La sesión se guarda en una cookie
# httpOnly firmada criptográficamente (HMAC-SHA256).
#
# Si dejas esta variable vacía o comentada, la aplicación será de acceso abierto
# (cada usuario igual deberá ingresar su propia API Key de Higgsfield en la UI).
APP_ACCESS_PASSWORD=

# Nota: NO existe una API Key global de Higgsfield en el servidor.
# Por diseño de seguridad y facturación individual, cada usuario ingresa su
# propia credencial (KEY_ID:KEY_SECRET) desde la interfaz web.
